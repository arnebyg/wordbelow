{
  "name": "wordbelow",
  "private": true,
  "description": "WordBelow: the web game (public/), its server (src/worker.js) and the iPhone app (ios/, Capacitor).",
  "scripts": {
    "strip": "node tools/strip.mjs",
    "deploy": "node tools/strip.mjs && wrangler deploy",
    "ios:sync": "node tools/strip.mjs && cap sync ios",
    "ios:copy": "node tools/strip.mjs && cap copy ios",
    "ios:open": "cap open ios",
    "deploy:site": "sh tools/site-build.sh && wrangler deploy -c wrangler.site.toml"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor-community/contacts": "^8.0.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capgo/native-purchases": "^8.9.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "acorn": "^8.19.0",
    "parse5": "^7.3.0",
    "postcss": "^8.5.32"
  }
}
